# Local Netlify folder
.netlify

# Python
__pycache__/
*.pyc
*.log

# Decimated preview intermediates -- rewritten on every render/report run
_*_dec.stl

# Oversized build outputs (>50 MB) -- regenerate with the project's build script
# instead of committing. GitHub warns at 50 MB and hard-rejects at 100 MB.
/projects/multifunction_terrarium/drip_gutters.stl
/projects/faraday_instability_disc/faraday_disc.stl
/projects/golden_ratio_scrying_pool/scrying_pool.stl
# Solver snapshots -- ~100 MB per run. Regenerate with plume_lbm.py; the derived
# figures, summary.json and core_fits.json are small and are kept.
/projects/thermal_plume/run_*/fields.npz

# Private -- personal content, never publish
/projects/lifetube/
**/lifetube*

# Volumetric sound forms -- regenerated by run_pure.mjs / sound_form_reference.py
/projects/volumetric_sound_forms/js_*.stl
/projects/volumetric_sound_forms/py_*.stl
/projects/volumetric_sound_forms/demo_field.*
/projects/volumetric_sound_forms/demo_surface.f32
/projects/volumetric_sound_forms/demo_cavity.json
/projects/volumetric_sound_forms/demo_cavity_field.f32
/projects/volumetric_sound_forms/demo_wave.json
/projects/volumetric_sound_forms/demo_voice.f32
/projects/volumetric_sound_forms/__pycache__/
/projects/volumetric_sound_forms/test_tone.wav
